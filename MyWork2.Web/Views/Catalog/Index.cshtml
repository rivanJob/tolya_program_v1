@model List<MyWork2.Web.Models.CatalogItem>
<h2>Заказы ремонта</h2>
<table class="table table-striped table-sm">
    <thead><tr><th>ID</th><th>Клиент</th><th>Телефон</th><th>Устройство</th><th>Статус</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.Id</td><td>@item.surname</td><td>@item.phone</td><td>@item.brand @item.model</td><td>@item.Status_remonta</td>
            <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Открыть</a></td>
        </tr>
    }
    </tbody>
</table>
