@model MyWork2.Web.ViewModels.HomeIndexVm
<div class="row g-3">
    <div class="col-md-3"><div class="card card-kpi"><div class="card-body"><h6>Всего заказов</h6><h3>@Model.TotalOrders</h3></div></div></div>
    <div class="col-md-3"><div class="card card-kpi"><div class="card-body"><h6>Открытых заказов</h6><h3>@Model.OpenOrders</h3></div></div></div>
    <div class="col-md-3"><div class="card card-kpi"><div class="card-body"><h6>Клиентов</h6><h3>@Model.Clients</h3></div></div></div>
    <div class="col-md-3"><div class="card card-kpi"><div class="card-body"><h6>Позиций склада</h6><h3>@Model.StockItems</h3></div></div></div>
</div>
