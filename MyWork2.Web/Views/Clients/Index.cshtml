@model List<MyWork2.Web.Models.Client>
<h2>Клиенты</h2>
<table class="table table-striped table-sm">
<thead><tr><th>ID</th><th>ФИО</th><th>Телефон</th><th>Адрес</th></tr></thead>
<tbody>
@foreach (var item in Model) {
<tr><td>@item.Id</td><td>@item.FIO</td><td>@item.Phone</td><td>@item.Adress</td></tr>
}
</tbody>
</table>
