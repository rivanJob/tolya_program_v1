<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MyWork2 Web</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">ServiceCenter Web</a>
        <div class="navbar-nav">
            <a class="nav-link" asp-controller="Catalog" asp-action="Index">Заказы</a>
            <a class="nav-link" asp-controller="Clients" asp-action="Index">Клиенты</a>
            <a class="nav-link" asp-controller="Stock" asp-action="Index">Склад</a>
            <a class="nav-link" asp-controller="Settings" asp-action="Index">Настройки</a>
            <a class="nav-link" asp-controller="Home" asp-action="LegacyModules">Parity</a>
        </div>
    </div>
</nav>
<main class="container py-4">
    @RenderBody()
</main>
</body>
</html>
